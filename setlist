<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bookmark</title>
    <style>
        /* 화면 여백을 없애고 배경을 검게 만듭니다 */
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            background-color: #000;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden; /* 스크롤바가 생기는 것을 방지 */
            cursor: pointer; /* 터치/클릭이 가능하다는 걸 암시 */
            -webkit-tap-highlight-color: transparent; /* 폰에서 터치할 때 파란색 깜빡임 방지 */
        }

        /* 이미지 비율을 유지하면서 모바일 화면에 꽉 차게 맞춥니다 */
        #mainImage {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain; 
            transition: opacity 0.3s ease-in-out; /* 화면이 바뀔 때 살짝 부드럽게 전환되는 효과 */
        }
    </style>
</head>
<body>

    <img id="mainImage" src="poster.png" alt="Bookmark Concert">

    <script>
        // 화면(body) 전체에 터치/클릭 이벤트를 달아줍니다.
        const imgElement = document.getElementById('mainImage');
        
        document.body.addEventListener('click', function() {
            // 현재 이미지 주소를 확인해서 서로 바꿔줍니다.
            // (관객이 실수로 터치했을 때 다시 포스터로 돌아갈 수 있게 토글 방식으로 짰습니다)
            const currentSrc = imgElement.getAttribute('src');
            
            if (currentSrc === 'poster.png') {
                imgElement.src = 'setlist.png';
            } else {
                imgElement.src = 'poster.png';
            }
        });
    </script>

</body>
</html>
